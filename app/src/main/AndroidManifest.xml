<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The app talks to exactly one origin, over TLS only. See res/xml/network_security_config.xml. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Only for the download listener, and only on API 26-28, where writing to the public Downloads
      directory still required it. On API 29+ the system DownloadManager places the file itself and
      this app asks for nothing. No camera, no microphone, no storage reads, no notifications.
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".ArenaApplication"
        android:allowBackup="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.Arena.Starting"
        tools:targetApi="33">

        <!--
          configChanges: the whole point is that rotating the phone, folding it, moving it to split
          screen or flipping the system theme must not recreate the Activity. A recreation would mean
          a fresh page load, which is exactly what "don't reload my conversation" rules out. The
          WebView also lives in AppContainer, so even a real recreation re-attaches the same page.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|keyboard|keyboardHidden|navigation|uiMode|locale|layoutDirection|fontScale"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Arena.Starting"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- A tapped arena.ai link opens in the same window, after the same navigation policy. -->
            <intent-filter android:label="@string/intent_open_arena_link">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="arena.ai" />
                <data android:scheme="https" android:host="www.arena.ai" />
            </intent-filter>
        </activity>
    </application>
</manifest>
